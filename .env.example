# Target Website Configuration
TARGET_URL=https://e.com
SITE_NAME=Target Website

# Crawl Limitations
MAX_PAGES=15
MAX_DEPTH=2
TIMEOUT_MS=30000
DELAY_MS=1000

# Browser Setting (true = headless, false = visible browser)
HEADLESS=true

# Google Gemini API Key (Opsional, untuk Step 4 Analisis AI Otomatis via npm run analyze)
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=
